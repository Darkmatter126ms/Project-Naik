# --- Naik API environment (local dev) -------------------------------------
# On Render, DATABASE_URL is injected automatically by the Blueprint
# (render.yaml -> fromDatabase). Locally, leave it blank to run without a DB
# (health reports db: "not_configured"), or point it at a local Postgres.
DATABASE_URL=
APP_VERSION=0.1.0
# "*" allows any origin (fine for the public /health proof). For production,
# set this to your exact Vercel URL, e.g. https://naik-web.vercel.app
CORS_ORIGINS=*
